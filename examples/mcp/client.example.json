{
  "mcpServers": {
    "chariot": {
      "command": "./scripts/run-mcp-stdio.sh",
      "args": [],
      "env": {
        "CHARIOT_MCP_ENABLED": "true",
        "CHARIOT_MCP_TRANSPORT": "stdio"
      },
      "workingDirectory": "${repoRoot}"
    },
    "chariotHttp": {
      "type": "http",
      "url": "http://localhost:8087/mcp"
    }
  }
}
