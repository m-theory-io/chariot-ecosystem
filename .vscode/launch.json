                "CHARIOT_SANDBOX_ROOT": "${workspaceFolder}/data/sandboxes",
                "CHARIOT_SANDBOX_DEFAULT_SCOPE": "sandbox",
                "CHARIOT_BOOTSTRAP_EDIT_ENABLED": "true",
                "CHARIOT_MCP_ENABLED": "true",
                "CHARIOT_MCP_EXECUTE_ENABLED": "true",
                "CHARIOT_MCP_TRANSPORT": "http",
                "CHARIOT_MCP_WS_PATH": "/mcp",
