                "CHARIOT_COUCHBASE_URL": "couchbase://localhost",
                "CHARIOT_COUCHBASE_USER": "mtheory",
                "CHARIOT_COUCHBASE_PASSWORD": "Borg12731273",
                "CHARIOT_COUCHBASE_BUCKET": "chariot",
                "CHARIOT_COUCHBASE_CBDL": "true",
                "CHARIOT_SQL_HOST": "localhost",
                "CHARIOT_SQL_PORT": "3306",
                "CHARIOT_SQL_DATABASE": "chariot",
                "CHARIOT_SQL_USER": "chariot",
                "CHARIOT_SQL_PASSWORD": "chariot123",
                "CHARIOTEER_URL": "http://localhost:8080",
                "AZURE_TENANT_ID": "82fbfa53-3046-4f39-a182-f5e0082313d4",
                "AZURE_KEY_VAULT_URL": "https://chariot-vault.vault.azure.net",
                "AZURE_CONFIG_DIR": "/Users/williamhouse/.azure",
                "CHARIOT_VAULT_KEY_PREFIX": "local",
                "CHARIOT_SECRET_PROVIDER": "file",
                "CHARIOT_SECRET_FILE_PATH": "${workspaceFolder}/config/go-chariot/secrets.local.json",
                "CHARIOT_SANDBOX_ENABLED": "true",
                "CHARIOTEER_FILES_DIR": "${workspaceFolder}/data/files",
